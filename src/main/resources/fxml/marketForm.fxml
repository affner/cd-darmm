<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml" fx:controller="com.cwdarmm.controller.MarketFormController">
    <top>
        <ToolBar>
            <Label text="Markets" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Button text="Open Market" onAction="#onOpenMarket"/>
        </ToolBar>
    </top>
    <center>
        <TableView fx:id="tableMarkets">
            <columns>
                <TableColumn text="Account"      fx:id="colAccount"/>
                <TableColumn text="Market"       fx:id="colMarket"/>
                <TableColumn text="Market Data"  fx:id="colMarketData"/>
                <TableColumn text="Account Size" fx:id="colSize"/>
                <TableColumn text="Risk A"       fx:id="colRiskA"/>
                <TableColumn text="Risk B"       fx:id="colRiskB"/>
                <TableColumn text="Final House"  fx:id="colFinalHouse"/>
                <TableColumn text="Final Lunch"  fx:id="colFinalLunch"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
