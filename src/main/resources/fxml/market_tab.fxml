<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.cwdarmm.controller.MarketTabController"
      xmlns:fx="http://javafx.com/fxml"
      spacing="10" >

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Market:" style="-fx-font-weight: bold;"/>
        <Label fx:id="lblMarket" text="-" />
        <Button text="Gestionar riesgo" onAction="#openRiskManager"/>
    </HBox>

    <TableView fx:id="tblRisk" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="#"           prefWidth="40"/>
            <TableColumn text="Contracts"   prefWidth="100"/>
            <TableColumn text="Risk $"      prefWidth="100"/>
            <TableColumn text="Capital used"prefWidth="120"/>
            <TableColumn text="R:R"         prefWidth="80"/>
            <TableColumn text="% Risk"      prefWidth="80"/>
        </columns>
    </TableView>
</VBox>
