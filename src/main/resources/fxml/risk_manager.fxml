<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:controller="com.cwdarmm.controller.RiskManagerController"
          xmlns:fx="http://javafx.com/fxml"
          hgap="10" vgap="8" >

    <!-- Fila 0 -->
    <Label text="Account balance:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtBalance"           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <!-- Fila 1 -->
    <Label text="Stop (ticks):"   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtStopTicks"         GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <!-- Fila 2 -->
    <Label text="Tick value:"     GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="txtTickValue"         GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <!-- Fila 3 -->
    <Label text="Base % risk:"    GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="txtRiskPct"           GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <!-- Fila 4 -->
    <CheckBox text="Last trade was WIN" fx:id="chkLastWin"
              GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <!-- Fila 5 -->
    <Label text="Confidence tier:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ChoiceBox fx:id="cmbConf" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <!-- Botones -->
    <HBox spacing="10" alignment="CENTER_RIGHT"
          GridPane.rowIndex="6" GridPane.columnIndex="1">
        <Button text="Calculate" onAction="#onCalculate"/>
        <Button text="Cancel"    onAction="#onCancel"/>
    </HBox>
</GridPane>
