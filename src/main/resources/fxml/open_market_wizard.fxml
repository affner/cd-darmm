<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:controller="com.cwdarmm.controller.OpenMarketWizardController"
          xmlns:fx="http://javafx.com/fxml"
          hgap="10" vgap="8" >

    <!-- Fila 0 -->
    <Label text="Name:"      GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtName"                 GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <!-- Fila 1 -->
    <Label text="Symbol:"    GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtSymbol"               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <!-- Fila 2 -->
    <Label text="Tick size:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="txtTickSize"             GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <!-- Fila 3 -->
    <Label text="Tick value:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="txtTickValue"            GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <!-- Fila 4 -->
    <Label text="Default stop (ticks):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cmbDefaultStop"           GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <!-- Fila 5 -->
    <Label text="Color hex:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <TextField fx:id="txtColorHex"             GridPane.rowIndex="5" GridPane.columnIndex="1"/>

    <!-- Botones -->
    <HBox spacing="10" alignment="CENTER_RIGHT"
          GridPane.rowIndex="6" GridPane.columnIndex="1">
        <Button text="OK"     onAction="#onOk"/>
        <Button text="Cancel" onAction="#onCancel"/>
    </HBox>
</GridPane>
