<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cwdarmm.controller.RiskConfigController"
            prefWidth="720" prefHeight="520" styleClass="dialog-root">
    <!-- Top: Título de la pestaña, puede incluir icono -->
    <top>
        <ToolBar styleClass="dialog-toolbar">
            <Label text="%risk.config.title" styleClass="dialog-title"/>
        </ToolBar>
    </top>

    <!-- Center: Formulario de inputs -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="dialog-scroll">
            <content>
                <VBox spacing="24" styleClass="dialog-container">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <VBox spacing="12">
                        <Label text="%risk.config.section.selection" styleClass="dialog-section-title"/>
                        <GridPane hgap="12" vgap="12" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="200" prefWidth="220" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="%risk.config.step1" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <ComboBox fx:id="cbRiskAccount" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                      maxWidth="Infinity" prefWidth="320"/>

                            <Label text="%risk.config.step2" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <ComboBox fx:id="cbRiskMarket" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                      maxWidth="Infinity" prefWidth="320"/>

                            <Label text="%risk.config.step3" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <ComboBox fx:id="cbRiskMarketData" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                      maxWidth="Infinity" prefWidth="320"/>
                        </GridPane>
                    </VBox>

                    <Separator/>

                    <VBox spacing="12">
                        <Label text="%risk.config.section.parameters" styleClass="dialog-section-title"/>
                        <GridPane hgap="12" vgap="12" styleClass="form-grid">
                            <columnConstraints>
                                <ColumnConstraints minWidth="200" prefWidth="220" halignment="RIGHT"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="%risk.config.accountsize" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <TextField fx:id="tfRiskAccountSize" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                       maxWidth="Infinity" prefWidth="200"/>

                            <Label text="%risk.config.risktoreward" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <TextField fx:id="tfRiskReward" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                       maxWidth="Infinity" prefWidth="200"/>

                            <Label text="%risk.config.stoplosssize" GridPane.rowIndex="2" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <TextField fx:id="tfStopLossSize" GridPane.rowIndex="2" GridPane.columnIndex="1"
                                       maxWidth="Infinity" prefWidth="200"/>

                            <Label text="%risk.config.slsize" GridPane.rowIndex="3" GridPane.columnIndex="0"
                                   styleClass="form-label" wrapText="true"/>
                            <HBox spacing="12" GridPane.rowIndex="3" GridPane.columnIndex="1" alignment="CENTER_LEFT">
                                <TextField fx:id="tfTicksSl1" prefWidth="120" promptText="%risk.config.slsize.primary"/>
                                <TextField fx:id="tfTicksSl2" prefWidth="120" promptText="%risk.config.slsize.secondary"/>
                            </HBox>
                        </GridPane>
                    </VBox>

                    <Separator/>

                    <VBox spacing="12">
                        <Label text="%risk.config.section.sessions" styleClass="dialog-section-title"/>
                        <StackPane styleClass="session-wrapper">
                            <FlowPane hgap="16" vgap="12" prefWrapLength="360" styleClass="session-flow">
                                <CheckBox fx:id="chkHouse" text="%risk.config.house" mnemonicParsing="false"/>
                                <CheckBox fx:id="chkLunch" text="%risk.config.lunch" mnemonicParsing="false"/>
                                <CheckBox fx:id="chkWin" text="%risk.config.win" mnemonicParsing="false"/>
                                <CheckBox fx:id="chkLoss" text="%risk.config.loss" mnemonicParsing="false"/>
                            </FlowPane>
                        </StackPane>
                    </VBox>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="%risk.config.optimalcontracts" onAction="#onCalculate"/>
                        <Button text="%risk.config.close" onAction="#onClose"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Bottom: Imagen decorativa -->
    <bottom>
        <ImageView fx:id="imgCoins" fitHeight="40" preserveRatio="true" pickOnBounds="true"/>
    </bottom>
</BorderPane>
