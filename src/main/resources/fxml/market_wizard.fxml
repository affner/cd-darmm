<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:controller="com.cwdarmm.controller.MarketWizardController"
          xmlns:fx="http://javafx.com/fxml"
          hgap="12" vgap="8" >
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

    <!-- ─────────── COL-0  “step” etiquetas ─────────── -->
    <Label text="Step 1"           GridPane.rowIndex="0"/>
    <Label text="Account"          GridPane.rowIndex="1"/>

    <Label text="Step 2"           GridPane.rowIndex="2"/>
    <Label text="Market"           GridPane.rowIndex="3"/>

    <Label text="Step 3"           GridPane.rowIndex="4"/>
    <Label text="Market Data"      GridPane.rowIndex="5"/>

    <!-- ─────────── COL-1  combos ─────────── -->
    <ChoiceBox fx:id="cmbAccount"  prefWidth="160"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <ChoiceBox fx:id="cmbMarket"   prefWidth="160"
               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <ChoiceBox fx:id="cmbMktData"  prefWidth="160"
               GridPane.columnIndex="1" GridPane.rowIndex="5"/>

    <!-- ─────────── COL-2  labels numéricos ─────────── -->
    <Label text="ACCOUNT SIZE :"        GridPane.columnIndex="2" GridPane.rowIndex="0"/>
    <Label text="RISK PERCENTAGE A:"    GridPane.columnIndex="2" GridPane.rowIndex="1"/>
    <Label text="RISK PERCENTAGE B:"    GridPane.columnIndex="2" GridPane.rowIndex="2"/>

    <!-- ─────────── COL-3  fields numéricos ─────────── -->
    <TextField fx:id="txtAccountSize"   prefWidth="140"
               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

    <TextField fx:id="txtRiskA"         prefWidth="140"
               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

    <TextField fx:id="txtRiskB"         prefWidth="140"
               GridPane.columnIndex="3" GridPane.rowIndex="2"/>

    <!-- ─────────── COL-4  botones ─────────── -->
    <VBox spacing="12"
          GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.rowSpan="3">
        <Button text="OPEN MARKET" fx:id="btnOpen"  onAction="#onOpenMarket" prefWidth="140"/>
        <Button text="CLOSE"                   onAction="#onClose"      prefWidth="140"/>
    </VBox>
</GridPane>
