<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.cwdarmm.controller.MainController"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1280" prefHeight="800">

    <!-- ——— MENÚ SUPERIOR ——— -->
    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Exit"   onAction="#onExit"/>
            </Menu>
            <Menu text="Catalogs">
                <MenuItem text="Markets" onAction="#openMarketCatalog"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- ——— CONTENIDO CENTRAL: pestañas dinámicas de mercados ——— -->
    <center>
        <TabPane fx:id="marketsPane"/>
    </center>
</BorderPane>
