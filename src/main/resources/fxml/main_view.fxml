<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.cwdarmm.controller.MainController"
            xmlns:fx="http://javafx.com/fxml" prefWidth="1280" prefHeight="800">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Exit" onAction="#onExit"/>
            </Menu>
            <Menu text="Catalogs">
                <MenuItem text="Markets"  onAction="#openMarketCatalog"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <!-- Contenedor dinámico donde se cargan los demás FXML -->
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
